# ==============================================================================
# DrinkTheStick - Environment Configuration
# ==============================================================================
# Copy this file to .env and configure your Telegram Bot token:
#   cp .env.example .env
#
# IMPORTANT: .env contains sensitive secrets and is ignored by git.
# ==============================================================================

# Telegram Bot token obtained from @BotFather (Required)
TOKEN=your_telegram_bot_token_here

# Automated scraping and notification schedule (Optional, default: "*/15 * * * *")
SCHEDULE_CRON=*/15 * * * *

# Price threshold in USD for bargain offer alerts (Optional, default: 800)
MAX_OFFER_PRICE=800

# Puppeteer headless mode: true (default) or false for visual debugging
# PUPPETEER_HEADLESS=true

# ------------------------------------------------------------------------------
# Testing Only (Optional - used only when running `LIVE_TEST=true npm test`)
# ------------------------------------------------------------------------------
# Safety guard for live end-to-end tests: must end in '440' so live test runs
# never message unrelated users. Not used or enforced in normal production runs.
# TELEGRAM_CHAT_ID=your_test_chat_id_ending_in_440
